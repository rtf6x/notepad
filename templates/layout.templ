package templates

import "github.com/rtf6x/notepad/internal/view"

templ authHead(title string) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ title }</title>
	@socialMeta(title, siteDescription)
	<link rel="shortcut icon" type="image/png" href="/favicon.png"/>
	<link rel="preload" href="/images/back.jpg" as="image" type="image/jpeg"/>
	<link rel="stylesheet" href="/css/app.css"/>
}

templ notesHead(title string) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ title }</title>
	@socialMeta(title, siteDescription)
	<link rel="shortcut icon" type="image/png" href="/favicon.png"/>
	<link rel="preload" href="/images/title.png" as="image" type="image/png"/>
	<link rel="preload" href="/images/note-top.png" as="image" type="image/png"/>
	<link rel="preload" href="/images/note-end.png" as="image" type="image/png"/>
	<link rel="preload" href="/images/editor-line.png" as="image" type="image/png"/>
	<link rel="stylesheet" href="/css/app.css"/>
	<link rel="stylesheet" href="/app/notes.css"/>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Neucha&subset=latin,cyrillic"/>
}

templ authLayout(title string, data view.AuthPage, body templ.Component) {
	<!doctype html>
	<html lang="en">
		<head>
			@authHead(title)
		</head>
		<body class="auth-page">
			<div class="login-bg" aria-hidden="true"></div>
			<div class="login-wrapper" id="auth-panel">
				if data.Error != "" {
					<p class="flash flash-error">{ data.Error }</p>
				}
				if data.Flash.Message != "" {
					<p class={ "flash", "flash-" + data.Flash.Kind }>{ data.Flash.Message }</p>
				}
				@body
			</div>
			<script src="/js/auth.js" defer></script>
		</body>
	</html>
}
